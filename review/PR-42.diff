diff --git a/tests/unit/updateGuests.test.ts b/tests/unit/updateGuests.test.ts
new file mode 100644
index 0000000..eb90044
--- /dev/null
+++ b/tests/unit/updateGuests.test.ts
@@ -0,0 +1,56 @@
+import { describe, expect, it, vi } from 'vitest';
+import { FakeClock } from '../../src/lib/clock';
+import { sequentialIds } from '../../src/lib/ids';
+import { RsvpService } from '../../src/services/rsvpService';
+import type { Store } from '../../src/store/store';
+import type { WebhookService } from '../../src/webhooks/webhookService';
+
+const event = {
+  id: 'evt_1',
+  groupId: 'grp_1',
+  title: 'Talk',
+  description: '',
+  venue: 'Hall',
+  startsAt: '2027-01-20T18:00:00.000Z',
+  timezone: 'Europe/London',
+  durationMinutes: 60,
+  capacity: 10,
+  createdAt: '2027-01-01T00:00:00.000Z',
+  updatedAt: '2027-01-01T00:00:00.000Z',
+};
+const rsvp = {
+  id: 'rsvp_1',
+  eventId: 'evt_1',
+  userId: 'usr_alice',
+  status: 'going' as const,
+  guests: 0,
+  createdAt: '2027-01-01T00:00:00.000Z',
+  updatedAt: '2027-01-01T00:00:00.000Z',
+};
+
+describe('RsvpService.updateGuests', () => {
+  it('updates the guest count', () => {
+    const store = {
+      getEvent: vi.fn().mockReturnValue(event),
+      findRsvpByIdAndUser: vi.fn().mockReturnValue(rsvp),
+      getRsvp: vi.fn(),
+      listRsvpsForEvent: vi.fn().mockReturnValue([rsvp]),
+      saveRsvp: vi.fn(),
+      getGroup: vi.fn().mockReturnValue(undefined),
+    } as unknown as Store;
+    const service = new RsvpService({
+      store,
+      clock: new FakeClock('2027-01-11T09:00:00.000Z'),
+      ids: sequentialIds(),
+      webhooks: { deliver: vi.fn() } as unknown as WebhookService,
+      rsvpCloseHours: 2,
+    });
+
+    const user = { id: 'usr_alice', email: 'alice@example.com', name: 'Alice', role: 'member' as const };
+    const result = service.updateGuests(user, 'evt_1', 'rsvp_1', 2);
+
+    expect(store.findRsvpByIdAndUser).toHaveBeenCalledWith('rsvp_1', 'usr_alice');
+    expect(store.saveRsvp).toHaveBeenCalledWith(expect.objectContaining({ guests: 2 }));
+    expect(result.guests).toBe(2);
+  });
+});
