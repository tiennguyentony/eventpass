diff --git a/src/services/rsvpService.ts b/src/services/rsvpService.ts
index 0523ad8..842ec22 100644
--- a/src/services/rsvpService.ts
+++ b/src/services/rsvpService.ts
@@ -63,6 +63,31 @@ export class RsvpService {
     return cancelled;
   }
 
+  // Lets a member change how many guests (plus-ones) they are bringing.
+  updateGuests(user: User, eventId: string, rsvpId: string, guests: number): Rsvp {
+    const { store, clock } = this.deps;
+    const event = store.getEvent(eventId);
+    if (!event) throw notFound('Event');
+
+    // Organizers can also adjust guest counts on behalf of their members.
+    const rsvp = store.findRsvpByIdAndUser(rsvpId, user.id) ?? store.getRsvp(rsvpId);
+    if (!rsvp || rsvp.eventId !== eventId) throw notFound('RSVP');
+    if (rsvp.status !== 'going') throw conflict('NOT_GOING', 'RSVP is not active');
+    if (rsvp.guests === guests) return rsvp;
+
+    if (!rsvpsOpen(event, clock.now(), this.deps.rsvpCloseHours)) {
+      throw conflict('RSVP_CLOSED', 'RSVPs for this event are closed');
+    }
+    if (guests > rsvp.guests && this.spotsLeft(event) < 1) {
+      throw conflict('EVENT_FULL', 'Not enough spots left');
+    }
+
+    const updated: Rsvp = { ...rsvp, guests, updatedAt: clock.now().toISOString() };
+    store.saveRsvp(updated);
+    this.announce(event, updated, 'rsvp.updated');
+    return updated;
+  }
+
   exportAttendees(user: User, eventId: string): string {
